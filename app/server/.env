# Frontend URL (used in email links + CORS)
CLIENT_URL="http://localhost:5173"

# ── Shipping Rates ────────────────────────────────────────────────────────────
# Flat rate shipping costs by country (in your currency).
# Format: SHIPPING_RATE_<COUNTRY_CODE>=<amount>
# Use SHIPPING_RATE_DEFAULT for any country not listed.
# Set to 0 for free shipping.
SHIPPING_RATE_NZ=20
SHIPPING_RATE_AU=15
SHIPPING_RATE_US=25
SHIPPING_RATE_GB=20
SHIPPING_RATE_NP=110
SHIPPING_RATE_DEFAULT=30