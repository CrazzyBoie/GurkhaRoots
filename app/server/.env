# ── LOCAL IMAGE STORAGE ──────────────────────────────────────
# Images are saved to /server/uploads/products/ on disk.
# SERVER_URL is used to build the public URL returned to the frontend.
# Development:
SERVER_URL="http://localhost:5000"
# Production: SERVER_URL="https://your-api-domain.com"
#
# CLOUDINARY IS NO LONGER USED — remove these if present:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ─────────────────────────────────────────────────────────────

# Stripe  (Google Pay goes through Stripe — no separate gateway needed)
# ── Get these from https://dashboard.stripe.com/test/apikeys ──
